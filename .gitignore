# macOS / OS junk
.DS_Store
**/.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/

# Dev tooling workspaces
.claude/
.opencode/
node_modules/

# Local data-build & convert pipeline — not needed to serve the site
tools/

# Local image masters (originals kept locally, not pushed)
img-source-original/
img-sources-leftover*/

# Outfit PNG masters at repo root — only assets/outfits/*.webp is shipped.
# Use a leading slash so this only matches the top-level folder; the served
# webps under assets/outfits/ are NOT excluded.
/outfits/

# Backups / scratch
*.bak
*.orig
*.tmp

# Logs
*.log
